<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="locker_log_report_a4" model="report.paperformat">
    <field name="name">locker_log Report A4 Portrait</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_height">297</field>
    <field name="page_width">210</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">5</field>
    <field name="margin_bottom">3</field>
    <field name="margin_left">1</field>
    <field name="margin_right">1</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">3</field>
    <field name="dpi">120</field>
</record>

    <record id="locker_log_report" model="ir.actions.report">
        <field name="name">locker_log Report</field>
        <field name="model">sd_payaneh_nafti.locker_log</field>
<!--        <field name="report_type">qweb-html</field>-->
<!--        <field name="report_type">xlsx</field>-->
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sd_payaneh_nafti.locker_log_report_template</field>
        <field name="report_file">sd_payaneh_nafti.locker_log_report_template</field>
        <field name="print_report_name">'locker_logReport-%s' % object.document_no </field>
        <field name="paperformat_id" ref="locker_log_report_a4"/>
<!--        <field name="binding_model_id" ref="model_sd_payaneh_nafti_locker_log"/>-->
<!--        <field name="binding_type">report</field>-->

    </record>

