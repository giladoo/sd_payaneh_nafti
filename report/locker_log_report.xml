    <record id="locker_log_sheet" model="ir.actions.report">
        <field name="name">Logger Log Sheet</field>
        <field name="model">sd_payaneh_nafti.locker_log</field>
        <field name="report_type">qweb-html</field>
<!--        <field name="report_type">xlsx</field>-->
<!--        <field name="report_type">qweb-pdf</field>-->
        <field name="report_name">sd_payaneh_nafti.locker_log_sheet_template</field>
        <field name="report_file">sd_payaneh_nafti.locker_log_sheet_template</field>
        <field name="print_report_name">'locker_log-%s' % object.subject </field>
        <field name="paperformat_id" ref="locker_log_report_a4"/>
        <field name="binding_model_id" ref="model_sd_payaneh_nafti_locker_log"/>
