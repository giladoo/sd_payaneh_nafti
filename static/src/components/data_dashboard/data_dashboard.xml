<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="data_dashboard" owl="1">
        <div class="bg-mute h-100 overflow-auto" >
            <div class="row m-1 m-lg-3">
                <div class="col-lg-8">
                    <div class="row shadow rounded mx-n3 p-lg-4 bg-white text-center">
                        <div class="col-8 ">
                            <div class="">
                                <div class="d-flex  align-items-center">
                                    <div class="">
                                       <img alt="Logo" t-att-src="'/logo?company=1'" t-att-alt="''"
                                                        style=" height: 40px;" height="40"/>
                                    </div>
                                    <div class=" ">
                                        <h1 class="text-primary fw-bold mx-4 my-0" t-esc="state.title.name"></h1>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-4 row m-0 align-content-center justify-content-end ">
<!--                            <button class="btn btn-outline-info mx-1" t-on-click="onAnalysisClick" t-ref="analysis">Analysis</button>-->
                            <button class="btn btn-outline-info mx-1" t-on-click="() => onSubDashboardClick('meters')" >Meters</button>

                        </div>
                    </div>
                    <div class="row">
                        <DataCards  name="''" status="state.username.status"  />
                        <DataCards onClick="viewSpgr" name="'SP.GR.'" status="state.spgr.status" value="state.spgr.value" />
                        <DataCards name="state.load_plan.name" link="state.load_plan.link" class="loading_plan_card"/>
                        <DataCards onClick="viewContracts" name="state.contracts.name" status="state.contracts.status" value="state.contracts.value" />
                    </div>
                    <div class="row">
                        <InputCards onSubmit="toOpenInputInfo" name="state.openInputInfo.name"
                                    view="state.openInputInfo.view"
                                    onChange="onChange"
                                    status="state.openInputInfo.status" />
                        <DataCards onClick="()=>newRequestCreation()"   status="state.newRequest.status"   />
                        <DataLockers onClick="()=>viewLockerPackage()"   name="state.lockers.name"   status="state.lockers.status"   />
                    </div>
                    <div class="row">
                        <DataCards onClick="()=>viewThisDayRequests(0)"   status="state.this_day_requests_count.status" value="state.this_day_requests_count.value"  />
                        <DataCards onClick="()=>viewThisDayRequests(-1)"  status="state.one_day_ago_count.status" value="state.one_day_ago_count.value"  />
                        <DataCards onClick="()=>viewThisDayRequests(-2)"  status="state.two_days_ago_count.status" value="state.two_days_ago_count.value"  />
                        <DataCards onClick="()=>viewThisDayRequests(-3)"  status="state.three_days_ago_count.status" value="state.three_days_ago_count.value"  />
                    </div>
                    <div class="row">
                        <DataCards onClick="viewNewRequests" name="state.new_requests.name" status="state.new_requests.status" value="state.new_requests.value" lang="lang"/>
                        <DataCards onClick="viewLoadingPermit" name="state.loading_permit.name" status="state.loading_permit.status" value="state.loading_permit.value" />
                        <DataCards onClick="viewLoadingInfo" name="state.loading_info.name" status="state.loading_info.status" value="state.loading_info.value" />
                        <DataCards onClick="viewCargoDocument" name="state.cargo_document.name" status="state.cargo_document.status" value="state.cargo_document.value" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="col m-0 p-0">
                        <div class="shadow border m-2 p-4 bg-white sd_payaneh_input_plans ">
                            <div class="row bg-300 text-center">
                                <div class="col-2"><t t-esc="state.meter_data.name[0]"/></div>
                                <div class="col-3"><t t-esc="state.meter_data.name[1]"/></div>
                                <div class="col-3"><t t-esc="state.meter_data.name[2]"/></div>
                                <div class="col-2"><t t-esc="state.meter_data.name[3]"/></div>
                                <div class="col-2"><t t-esc="state.meter_data.name[4]"/></div>
                            </div>
                            <div class="mx-3" t-raw="state.meter_data.value.meter_data"></div>
                        </div>
                    </div>
                    <DataPlans onClick="viewTodayLoadingPlan" name="state.plan_detail.name" status="state.plan_detail.status"  />
                </div>
            </div>
        </div>
    </t>
</templates>