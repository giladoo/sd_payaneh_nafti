<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="data_lockers" owl="1">
        <div class="col m-0 p-0">
            <div class="shadow border m-2 p-4 bg-white sd_payaneh_data_lockers "
                 t-on-click="props.hasOwnProperty('onClick') ? ()=>props.onClick() : ''"
                 t-attf-style=" {{props.hasOwnProperty('onClick') ? 'cursor: pointer;' : ''}}">
                <div class="h3 text-muted">
                    <span t-esc="props.name"></span>
                </div>
                <div class="row mx-1 bg-600 ">
                    <div class="col-2">Box</div>
                    <div class="col-4">Start No</div>
                    <div class="col-4">End No</div>
                    <div class="col-2">Available</div>
                </div>
                <t t-foreach="props.status" t-as="row_data" t-key="row_data">

<!--                    <div t-if="row_data.total == 'total'" class="row mx-1 border-top border-dark font-weight-bold">-->
<!--                        <div class="col-6" ></div>-->
<!--                        <div class="col-2" ></div>-->
<!--                        <div class="col-2" t-esc="row_data.locker"></div>-->
<!--                        <div class="col-2" t-esc="row_data.load"></div>-->
<!--                    </div>-->
                    <div class="row mx-1 border-bottom">
                        <div class="col-2" t-esc="row_data.box_no"></div>
                        <div class="col-4" t-esc="row_data.start_no"></div>
                        <div class="col-4" t-esc="row_data.end_no"></div>
                        <div class="col-2" t-esc="row_data.available"></div>
                    </div>

                </t>
            </div>
        </div>

    </t>
</templates>