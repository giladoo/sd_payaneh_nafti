<odoo>
    <data>

         <!-- ==================================================  sd_payaneh_nafti.spgr ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_spgr_list">
            <field name="name">spgr List</field>
            <field name="model">sd_payaneh_nafti.spgr</field>
            <field name="arch" type="xml">
                <tree delete="0" edit="0" decoration-bf="active" decoration-muted="not active" >
                        <field name="active" invisible="1" />
                        <field name="spgr" />
                        <field name="centralized_container" />
                        <field name="api_a" />
                        <field name="vapour_pressure" />
                        <field name="salt_content" />
                        <field name="mercaptans" />
                        <field name="h2s" />
                        <field name="sulphur" />
                        <field name="water_content" />
                        <field name="spgr_date" />
                    <field name="description" />

                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="sd_payaneh_nafti_spgr_form">
            <field name="name">spgr Form</field>
            <field name="model">sd_payaneh_nafti.spgr</field>
            <field name="arch" type="xml">
                <form edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="spgr" />
                                <field name="centralized_container" />
                                <field name="api_a" />
                                <field name="vapour_pressure" />
                                <field name="salt_content" />
                                <field name="mercaptans" />
                                <field name="h2s" />
                                <field name="sulphur" />
                                <field name="water_content" />
                                <field name="spgr_date" readonly="1"/>
                                <field name="description" />

                            </group>

                        </group>
                    </sheet>
                   <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ==================================================  Search ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_spgr_list_search">
            <field name="name">spgr Search</field>
            <field name="model">sd_payaneh_nafti.spgr</field>
            <field name="arch" type="xml">
                <search string="spgr">
                    <field name="spgr"/>
                    <field name="spgr_date"/>
                    <field name="active"/>
                    <field name="description" />
<!--                    <filter name="show_all" string="All" domain="['|', ('active', '=', True), ('active', '=', False), ]"/>-->
                    <filter name="show_active" string="Active" domain="[('active', '=', True)]"/>
<!--                    <filter name="show_all" string="All" domain="[ ]" context="{}"/>-->
                </search>
            </field>
        </record>


        <!-- ==================================================  Action Window ====================-->

        <record model="ir.actions.act_window" id="action_window_spgr">
            <field name="name">SPGR</field>
            <field name="res_model">sd_payaneh_nafti.spgr</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field>
            <field name="context">{'search_default_show_active': True}</field>
        </record>

        <!-- ==================================================  Menu ====================-->

        <menuitem name="SPGR"
                  sequence="50"
                  id="spgr_menu"
                  parent="settings_menu"
                  action="action_window_spgr"/>

<!--        <menuitem name="Actions"-->
<!--                  id="sd_payaneh_nafti.actions_setting_menu"-->
<!--                  parent="sd_payaneh_nafti.settings_menu"/>-->


    </data>
</odoo>
