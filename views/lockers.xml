<odoo>
    <data>
        <!-- ==================================================  sd_payaneh_nafti.lockers ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_lockers_list">
            <field name="name">Lockers List 2</field>
            <field name="model">sd_payaneh_nafti.lockers</field>
            <field name="arch" type="xml">
                <tree editable="top" delete="1" create="0">
                    <field name="locker_no" class="sd_ltr"/>
                    <field name="package_sequence" invisible="1"/>
                    <field name="package_id"  class="sd_ltr" widget="badge"/>

                    <field name="locker_type"/>
                    <field name="input_info"/>
                    <field name="locker_log"/>
<!--                    <field name="package_id"/>-->
                    <field name="package_state" />
                    <field name="batch_group"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="sd_payaneh_nafti_lockers_list_search">
            <field name="name">Lockers Search</field>
            <field name="model">sd_payaneh_nafti.lockers</field>
            <field name="arch" type="xml">
                <search string="Lockers">
                    <field name="locker_no"/>
                    <field name="input_info"/>
                    <field name="locker_log"/>
                    <field name="package_id"/>
                    <field name="package_sequence" invisible="1"/>
                    <filter name="package_group" string="Packages" context="{'group_by': 'package_id'}"/>
                    <filter name="input_info_group" string="Inputs" context="{'group_by': 'input_info'}"/>
                </search>
            </field>
        </record>

        <!-- ==================================================  sd_payaneh_nafti.locker_type ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_type_list">
            <field name="name">Locker Type List</field>
            <field name="model">sd_payaneh_nafti.locker_type</field>
            <field name="arch" type="xml">
                <tree editable="bottom" delete="1" multi_edit="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                </tree>
            </field>
        </record>

        <!-- ==================================================  sd_payaneh_nafti.locker_batch ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_batch_form">
            <field name="name">Locker Batch Form</field>
            <field name="model">sd_payaneh_nafti.locker_batch</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <button string="Publish"
                                name="lockers_button" type="object" class="btn btn-outline-success"
                                attrs="{'invisible': [('state', 'not in', ['draft', 'paused'])]}"
                                context="{'locker_btn':'publish'}"/>

                        <button string="Pause"
                                name="lockers_button" type="object" class="btn btn-outline-info"
                                attrs="{'invisible': [('state', 'not in', ['published', 'canceled'])]}"
                                context="{'locker_btn':'pause'}"/>

                        <button string="Draft"
                                name="lockers_button" type="object" class="btn btn-outline-info"
                                attrs="{'invisible': ['|', ('is_inuse', '=', True),('state', '=', 'draft')]}"
                                context="{'locker_btn':'draft'}"/>

                        <button string="View"
                                name="lockers_button" type="object" class="btn btn-outline-info"

                                context="{'locker_btn':'view'}"/>
                    </header>
                    <sheet>

                        <group>
                            <group>
                                <field name="state" widget="statusbar" statusbar_visible="recruit,open"/>
                                <field name="start_no" class="sd_ltr" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="end_no" class="sd_ltr" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="package_count" class="text-center" attrs="{'readonly': [('state', '!=', 'draft')]}"/>

                                <field name="count" class="text-center"/>
                                <field name="free_lockers" class="text-center"/>
                                <field name="is_inuse" invisible="1"/>
                                <field name="receive_date" class="text-center"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="letter_no" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="description" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="file_name" invisible="1"/>
                                <field name="attachment" widget="binary" filename="file_name"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>


                            </group>


                        </group>
                        <group>
                            <field name="packages" class="text-center">
                                <tree create="0" delete="0">

<!--                                    <field name="sequence"/>-->
                                    <field name="sequence" widget="handle"/>
                                    <field name="box_no"/>
<!--                                    <field name="batch_id"/>-->
                                    <field name="start_no"/>
                                    <field name="end_no"/>
                                    <field name="package_count"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_batch_list">
            <field name="name">Locker Batch List</field>
            <field name="model">sd_payaneh_nafti.locker_batch</field>
            <field name="arch" type="xml">

                <tree delete="1">
                    <field name="sequence" widget="handle"/>

                    <!--                    <button string="Publish"-->
                    <!--                            name="lockers_button" type="object" class="btn btn-outline-success"-->
                    <!--                            attrs="{'invisible': [('state', 'not in', ['draft', 'paused'])]}"-->
                    <!--                            context="{'locker_btn':'publish'}"/>-->

                    <!--                    <button string="Cancel"-->
                    <!--                            name="lockers_button" type="object" class="btn btn-outline-danger"-->
                    <!--                            attrs="{'invisible': [('state', 'not in', ['published', 'canceled'])]}"-->
                    <!--                            context="{'locker_btn':'cancel'}"/>-->

                    <!--                    <button string="Pause"-->
                    <!--                            name="lockers_button" type="object" class="btn btn-outline-info"-->
                    <!--                            attrs="{'invisible': [('state', 'not in', ['published', 'canceled'])]}"-->
                    <!--                            context="{'locker_btn':'pause'}"/>-->

                    <!--                    <button string="Draft"-->
                    <!--                            name="lockers_button" type="object" class="btn btn-outline-info"-->
                    <!--                            attrs="{'invisible': ['|', ('is_inuse', '=', True),('state', '=', 'draft')]}"-->
                    <!--                            context="{'locker_btn':'draft'}"/>-->

                    <!--                    <button string="View"-->
                    <!--                            name="lockers_button" type="object" class="btn btn-outline-info"-->

                    <!--                            context="{'locker_btn':'view'}"/>-->

                    <field name="start_no" class="sd_ltr" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="end_no" class="sd_ltr" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="package_count" class="text-center" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="count" class="text-center"/>
                    <field name="free_lockers" class="text-center"/>
                    <field name="is_inuse" invisible="1"/>
                    <field name="receive_date" class="text-center" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="letter_no" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="description" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="file_name" invisible="1"/>
                    <field name="attachment" widget="binary" filename="file_name"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-danger="state == 'canceled'"
                           decoration-info="state == 'paused'"
                    />
                </tree>
            </field>
        </record>

        <!-- ==================================================  sd_payaneh_nafti.locker_log ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_package_list">
            <field name="name">Locker Package List</field>
            <field name="model">sd_payaneh_nafti.locker_package</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <tree editable="top" create="0" delete="0">
                    <field name="sequence" widget="handle"/>
                    <field name="box_no" class="text-center" readonly="1"/>
                    <field name="start_no" class="sd_ltr" readonly="1"/>
                    <field name="end_no" class="sd_ltr" readonly="1"/>
                    <field name="available" class="text-center" readonly="1"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-danger="state == 'canceled'"
                           decoration-info="state == 'paused'"
                    />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_package_list_namage">
            <field name="name">Locker Package List</field>
            <field name="model">sd_payaneh_nafti.locker_package</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="sequence" widget="handle"/>
<!--                    <field name="sequence" class="text-center"/>-->
                    <field name="box_no" class="text-center"/>
                    <field name="start_no" class="sd_ltr"/>
                    <field name="end_no" class="sd_ltr"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-danger="state == 'canceled'"
                           decoration-info="state == 'paused'"
                    />
                </tree>
            </field>
        </record>


        <!-- ==================================================  sd_payaneh_nafti.locker_log ====================-->

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_log_list">
            <field name="name">Locker Log List</field>
            <field name="model">sd_payaneh_nafti.locker_log</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="subject"/>
                    <field name="issue_date"/>
                    <field name="lockers" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="sd_payaneh_nafti_locker_log_form">
            <field name="name">Locker Log List</field>
            <field name="model">sd_payaneh_nafti.locker_log</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="subject"/>
                            <h1>
                                <field name="subject" placeholder="e.g. Master meter repair"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="issue_date"/>
                                <field name="file_name" invisible="1"/>
                                <field name="attachment"/>

                            </group>
                            <div>

                                <field name="lockers" required="0" class="sd_ltr" widget="many2many"
                                       domain="[
                                           ('package_state', '=', 'published'),
                                           ('input_info', '=', False),
                                           ('locker_log', '=', False),
                                           ]">
                                    <tree editable="top" create="0" delete="1" default_order="locker_no">
                                        <field name="locker_no" class="sd_ltr" style="font-family: Arial !important;"
                                               readonly="1"/>
                                        <field name="locker_type" class="sd_ltr"
                                               domain="[('code', 'in', ['meter', 'report'] )]"
                                               options="{'no_open': 1, 'no_create': 1, 'no_edit': 1}"/>
                                    </tree>
                                </field>
                            </div>


                        </group>
                        <group string="Description">
                            <field name="description"/>

                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ==================================================  Action Window ====================-->

        <record model="ir.actions.act_window" id="action_window_lockers">
            <field name="name">Lockers 1</field>
            <field name="res_model">sd_payaneh_nafti.lockers</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_package_group': 1}</field>
        </record>

        <record model="ir.actions.act_window" id="action_window_locker_type">
            <field name="name">Locker Type</field>
            <field name="res_model">sd_payaneh_nafti.locker_type</field>
            <field name="view_mode">tree</field>
        </record>

        <record model="ir.actions.act_window" id="action_window_locker_batch">
            <field name="name">Locker Batch</field>
            <field name="res_model">sd_payaneh_nafti.locker_batch</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="action_window_locker_package">
            <field name="name">Locker Package 1</field>
            <field name="res_model">sd_payaneh_nafti.locker_package</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sd_payaneh_nafti_locker_package_list_namage"></field>
        </record>

        <record model="ir.actions.act_window" id="action_window_locker_log">
            <field name="name">Locker Log</field>
            <field name="res_model">sd_payaneh_nafti.locker_log</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ==================================================  Menu ====================-->

        <menuitem name="Lockers"
                  sequence="500"
                  id="lockers_menu"
                  parent="settings_menu"
                  action="action_window_lockers"/>

        <menuitem name="Locker Type"
                  sequence="500"
                  id="locker_type_menu"
                  parent="settings_menu"
                  action="action_window_locker_type"/>

        <menuitem name="Locker Batch"
                  sequence="500"
                  id="locker_batch_menu"
                  parent="settings_menu"
                  action="action_window_locker_batch"/>

        <menuitem name="Locker Package"
                  sequence="500"
                  id="locker_package_menu"
                  parent="settings_menu"
                  groups="base.group_system"
                  action="action_window_locker_package"/>

        <menuitem name="Locker Log"
                  sequence="500"
                  id="locker_log_menu"
                  parent="settings_menu"
                  action="action_window_locker_log"/>

    </data>
</odoo>
